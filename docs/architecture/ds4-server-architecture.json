  "cards": [
    {
      "dot": "cyan",
      "title": "Ingress and Compatibility",
      "items": [
        "Detached client thread per one-request TCP connection.",
        "OpenAI Chat, Responses, Completions, and Anthropic Messages normalize to one request.",
        "The same runtime serves models, health, stats, and dashboard routes."
      ]
    },
    {
      "dot": "emerald",
      "title": "Stateful Serving",
      "items": [
        "Best-prefix or live-tool match selects a resident slot.",
        "Fair prefill and coalesced decode share model execution.",
        "Live KV, hidden thinking, tool RAM, and disk snapshots avoid full replay."
      ]
    },
    {
      "dot": "violet",
      "title": "Inference and Scale Modes",
      "items": [
        "ds4_engine / ds4_session isolates HTTP from tensor internals.",
        "Metal, CUDA/ROCm, and CPU share exact session semantics.",
        "Scale with SSD experts, layer routes, or two-rank tensor parallelism."
      ]
    }
  ]
